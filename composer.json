{
    "name": "sikessem/components",
    "type": "library",
    "description": "Ready-to-use components, commands, presets, and customizations for Laravel & Filament.",
    "homepage": "https://sikessem.github.io/packages/filament",
    "license": "MIT",
    "keywords": [
        "sikessem",
        "filament",
        "laravel",
        "livewire",
        "tailwind",
        "components",
        "commands",
        "presets",
        "customizations",
        "art",
        "artisan",
        "artisan commands",
        "php"
    ],
    "authors": [
        {
            "name": "Sigui Kessé Emmanuel",
            "email": "siguici@proton.me",
            "homepage": "https://siguici.deno.dev"
        }
    ],
    "support": {
        "source": "https://github.com/sikessem/components",
        "issues": "https://github.com/sikessem/components/issues",
        "chat": "https://github.com/orgs/sikessem/discussions"
    },
    "require": {
        "php": ">=8.4",
        "filament/filament": "^4.6",
        "illuminate/console": "^12.48",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "Sikessem\\Components\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sikessem\\Components\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "laravel/framework": "<11.0.0"
    },
    "scripts": {
        "analyse": "phpinsights analyse",
        "check": "pint --test -v",
        "debug": [
            "@analyse",
            "@check",
            "@inspect",
            "@review",
            "@test"
        ],
        "fix": [
            "@refactor",
            "@format",
            "@lint"
        ],
        "format": "phpinsights fix",
        "inspect": "phpstan analyse --ansi --memory-limit=-1 --debug",
        "lint": "pint -v",
        "test": "pest --colors=always",
        "review": "rector --dry-run --debug",
        "refactor": "rector"
    },
    "extra": {
        "laravel": {
            "providers": ["Sikessem\\Components\\ComponentsServiceProvider"],
            "aliases": {
                "SikessemComponents": "Sikessem\\Components\\Components"
            },
            "dont-discover": []
        },
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "sikessem/laravel-devtools": "^1.5"
    }
}
